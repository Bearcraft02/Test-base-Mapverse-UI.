	document.addEventListener('DOMContentLoaded', function () {
		const header = document.querySelector('.center-header');
		const toggle = document.querySelector('.mobile-nav-toggle');
		const nav = document.getElementById('primary-navigation');
		const profile = document.querySelector('.profile-menu');
		const profileButton = document.querySelector('.profile-button');
		const notifications = document.querySelector('.notification-menu');
		const notificationButton = document.querySelector('.notification-bell-btn');
		if (!header || !toggle || !nav || !profile || !profileButton) return;

		function closeMenu() {
			header.classList.remove('is-open');
			toggle.setAttribute('aria-expanded', 'false');
			toggle.setAttribute('aria-label', 'Open navigation menu');
		}

		function closeProfile() {
			profile.classList.remove('is-open');
			profileButton.setAttribute('aria-expanded', 'false');
			profileButton.setAttribute('aria-label', 'Open profile menu');
		}
		function closeNotifications() {
			notifications?.classList.remove('is-open');
			notificationButton?.setAttribute('aria-expanded', 'false');
		}
		notificationButton?.addEventListener('click', function () {
			closeMenu();
			closeProfile();
			const opening = !notifications.classList.contains('is-open');
			notifications.classList.toggle('is-open', opening);
			notificationButton.setAttribute('aria-expanded', String(opening));
		});

		toggle.addEventListener('click', function () {
			closeNotifications();
			closeProfile();
			const opening = !header.classList.contains('is-open');
			header.classList.toggle('is-open', opening);
			toggle.setAttribute('aria-expanded', String(opening));
			toggle.setAttribute('aria-label', opening ? 'Close navigation menu' : 'Open navigation menu');
		});
		profileButton.addEventListener('click', function () {
			closeNotifications();
			closeMenu();
			const opening = !profile.classList.contains('is-open');
			profile.classList.toggle('is-open', opening);
			profileButton.setAttribute('aria-expanded', String(opening));
			profileButton.setAttribute('aria-label', opening ? 'Close profile menu' : 'Open profile menu');
		});

		document.addEventListener('click', function (event) {
			if (!header.contains(event.target)) closeMenu();
			if (!profile.contains(event.target)) closeProfile();
			if (!notifications?.contains(event.target)) closeNotifications();
		});
		document.addEventListener('keydown', function (event) {
			if (event.key === 'Escape') {
				if (header.classList.contains('is-open')) toggle.focus();
				if (notifications?.classList.contains('is-open')) notificationButton?.focus();
				if (profile.classList.contains('is-open')) profileButton.focus();
				closeMenu();
				closeProfile();
				closeNotifications();
			}
		});
		nav.querySelectorAll('a').forEach(function (link) {
			link.addEventListener('click', closeMenu);
		});
		window.addEventListener('resize', function () {
			if (window.innerWidth > 1200) closeMenu();
		});
	});
</script> <script>(function(){const backendUrl = "http://localhost:5001";

  document.addEventListener('DOMContentLoaded', function() {
    // Tags scroll
    var nav = document.querySelector('.tags');
    var leftBtn = document.querySelector('.tags-scroll-left');
    var rightBtn = document.querySelector('.tags-scroll-right');
    if (nav && leftBtn && rightBtn) {
      var scrollAmount = 200;
      function updateButtons() {
        leftBtn.classList.toggle('visible', nav.scrollLeft > 0);
        rightBtn.classList.toggle('visible', nav.scrollLeft < nav.scrollWidth - nav.clientWidth - 1);
      }
      leftBtn.addEventListener('click', function() { nav.scrollLeft -= scrollAmount; });
      rightBtn.addEventListener('click', function() { nav.scrollLeft += scrollAmount; });
      nav.addEventListener('scroll', updateButtons);
      window.addEventListener('resize', updateButtons);
      updateButtons();
    }

    // Notification system
    var badge = document.getElementById('notif-badge');
    var dropdownList = document.getElementById('notif-dropdown-list');
    var notifMenu = document.querySelector('.notification-menu');
    var token = notifMenu ? notifMenu.getAttribute('data-token') : '';
    var apiBase = notifMenu ? (notifMenu.getAttribute('data-api') || '') : (backendUrl || '');

    if (!badge || !token || !dropdownList) return;

    function getFriendIcon(n) {
      return n.type === 'warning' ? 'bi-exclamation-triangle-fill' : n.type === 'success' ? 'bi-check-circle-fill' : n.type === 'announcement' ? 'bi-megaphone-fill' : 'bi-info-circle-fill';
    }
    function getFriendColor(n) {
      return n.type === 'warning' ? '#f59e0b' : n.type === 'success' ? '#10b981' : n.type === 'announcement' ? '#8b5cf6' : '#3b82f6';
    }

    // Notification titles/messages and usernames are attacker-controlled: a
    // profile comment is echoed verbatim into notification.message. Anything
    // interpolated into innerHTML below must go through this first, or a
    // crafted comment executes script in the recipient's session (and the JWT
    // is readable from this element's data-token attribute).
    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Combined fetch: notifications + friend requests
    Promise.all([
      fetch(apiBase + '/api/notifications/unread-count', { headers: { 'Authorization': 'Bearer ' + token } }).then(function(r) { return r.json().catch(function() { return {}; }); }),
      fetch(apiBase + '/api/notifications?page=1&per_page=10', { headers: { 'Authorization': 'Bearer ' + token } }).then(function(r) { return r.json().catch(function() { return {}; }); }),
      fetch(apiBase + '/api/users/me/friends/pending', { headers: { 'Authorization': 'Bearer ' + token } }).then(function(r) { return r.json().catch(function() { return []; }); })
    ]).then(function(results) {
      var unreadData = results[0];
      var notifData = results[1];
      var pendingFriends = results[2];

      var unreadNotifs = unreadData.unread_count || 0;
      var totalBadge = unreadNotifs + (Array.isArray(pendingFriends) ? pendingFriends.length : 0);

      if (totalBadge > 0) {
        badge.textContent = totalBadge > 99 ? '99+' : String(totalBadge);
        badge.style.display = 'flex';
      } else {
        badge.style.display = 'none';
      }

      dropdownList.innerHTML = '';
      var hasContent = false;

      // Render pending friend requests first
      if (Array.isArray(pendingFriends) && pendingFriends.length > 0) {
        pendingFriends.forEach(function(req) {
          var u = req.user;
          var item = document.createElement('div');
          item.className = 'notif-dropdown-item unread friend-request-item';
          item.setAttribute('data-friend-id', req.id);
          item.innerHTML =
            '<span class="notif-icon" style="color:#f59e0b"><i class="bi bi-person-plus-fill"></i></span>' +
            '<div class="notif-body">' +
              '<p class="notif-title">Friend Request</p>' +
              '<p class="notif-msg"><strong>' + escapeHtml(u.username) + '</strong> wants to be your friend</p>' +
              '<span class="notif-time">Lv.' + Number(u.level || 1) + '</span>' +
            '</div>' +
            '<div class="friend-actions">' +
              '<button class="friend-accept-btn" title="Accept"><i class="bi bi-check-lg"></i></button>' +
              '<button class="friend-decline-btn" title="Decline"><i class="bi bi-x-lg"></i></button>' +
            '</div>';
          dropdownList.appendChild(item);

          // Wire accept button
          item.querySelector('.friend-accept-btn').addEventListener('click', function(e) {
            e.stopPropagation();
            e.preventDefault();
            fetch(apiBase + '/api/users/me/friends/' + req.id + '/accept', {
              method: 'PUT',
              headers: { 'Authorization': 'Bearer ' + token }
            }).then(function(r) {
              if (r.ok) {
                item.remove();
                updateBadge();
                recheckEmpty();
                if (window.showToast) window.showToast('Friend request accepted!', 'success', 'bi-person-check', 3000);
              }
            }).catch(function() {
              if (window.showToast) window.showToast('Failed to accept request', 'error', 'bi-exclamation-circle', 3000);
            });
          });

          // Wire decline button
          item.querySelector('.friend-decline-btn').addEventListener('click', function(e) {
            e.stopPropagation();
            e.preventDefault();
            fetch(apiBase + '/api/users/me/friends/' + req.id + '/decline', {
              method: 'PUT',
              headers: { 'Authorization': 'Bearer ' + token }
            }).then(function(r) {
              if (r.ok) {
                item.remove();
                updateBadge();
                recheckEmpty();
              }
            }).catch(function() {
              if (window.showToast) window.showToast('Failed to decline request', 'error', 'bi-exclamation-circle', 3000);
            });
          });
        });
        hasContent = true;
      }

      // Render unread notifications
      if (notifData.notifications) {
        var unread = notifData.notifications.filter(function(n) { return !n.is_read; });
        unread.slice(0, 5).forEach(function(n) {
          var destination = typeof n.link === 'string' && n.link.startsWith('/') && !n.link.startsWith('//') && !n.link.includes('\\') ? n.link : '/notifications';
          var item = document.createElement('a');
          item.href = destination;
          item.setAttribute('aria-label', 'Open notification: ' + n.title);
          item.className = 'notif-dropdown-item' + (n.is_read ? '' : ' unread');
          item.innerHTML =
            '<span class="notif-icon" style="color:' + getFriendColor(n) + '"><i class="bi ' + getFriendIcon(n) + '"></i></span>' +
            '<div class="notif-body">' +
              '<p class="notif-title">' + escapeHtml(n.title) + '</p>' +
              '<p class="notif-msg">' + escapeHtml(n.message) + '</p>' +
              (n.created_at ? '<span class="notif-time">' + new Date(n.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + '</span>' : '') +
            '</div>';
          item.addEventListener('click', function(event) {
            event.preventDefault();
            var done = false;
            function openNotification() { if (!done) { done = true; window.location.assign(destination); } }
            var fallback = setTimeout(openNotification, 900);
            fetch(apiBase + '/api/notifications/' + n.id + '/read', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token } })
              .catch(function() {}).finally(function() { clearTimeout(fallback); openNotification(); });
          });
          dropdownList.appendChild(item);
        });
        if (unread.length > 0) hasContent = true;
      }

      if (!hasContent) {
        dropdownList.innerHTML = '<div class="notif-empty">No new notifications</div>';
      }

      function recheckEmpty() {
        if (dropdownList.children.length === 0) {
          dropdownList.innerHTML = '<div class="notif-empty">No new notifications</div>';
        }
      }
    }).catch(function() {});

    function updateBadge() {
      fetch(apiBase + '/api/notifications/unread-count', { headers: { 'Authorization': 'Bearer ' + token } })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          fetch(apiBase + '/api/users/me/friends/pending', { headers: { 'Authorization': 'Bearer ' + token } })
            .then(function(r) { return r.json(); })
            .then(function(pending) {
              var total = (d.unread_count || 0) + (Array.isArray(pending) ? pending.length : 0);
              if (total > 0) {
                badge.textContent = total > 99 ? '99+' : String(total);
                badge.style.display = 'flex';
              } else {
                badge.style.display = 'none';
              }
            });
        });
    }
  });
})();</script> <script>
	// Compact header: switch to the slim fixed bar only after the full header is off screen,
	// and switch back before it would show again, so the page never jumps.
	(() => {
		// only the home page keeps the bar while you scroll
		const header = document.querySelector(".site-header[data-sticky]");
		if (!header) return;
		const root = document.documentElement;
		let full = 0, condensed = false, raf = 0;
		const measure = () => { if (!condensed) { const cs = getComputedStyle(header); full = header.offsetHeight + parseFloat(cs.marginBottom || "0"); root.style.setProperty("--hdr-full", full + "px"); } };
		const set = (on) => {
			if (on === condensed) return;
			if (!on) { header.classList.remove("is-condensed"); document.body.classList.remove("has-condensed-header"); condensed = false; measure(); return; }
			measure(); condensed = true;
			document.body.classList.add("has-condensed-header"); header.classList.add("is-condensed");
		};
		const check = () => { raf = 0; const y = window.scrollY; if (!condensed && y > full + 40) set(true); else if (condensed && y < full - 70) set(false); };
		measure();
		addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(check); }, { passive: true });
		addEventListener("resize", () => { measure(); check(); }, { passive: true });
		check();
		// the search button in the compact bar opens the full search
		header.querySelector(".hdr-search-btn")?.addEventListener("click", () => {
			window.scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
			setTimeout(() => document.getElementById("global-search")?.focus(), 350);
		});
	})();
