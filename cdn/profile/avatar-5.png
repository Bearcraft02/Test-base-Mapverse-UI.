</p> </footer>  <astro-island uid="Z13MgKN" component-url="/_astro/index.BVmdqp7g.js" component-export="ToastContainer" renderer-url="/_astro/client.svelte.Tl7DXQbT.js" props="{&quot;data-astro-cid-37fxchfa&quot;:[0,true]}" ssr client="load" opts="{&quot;name&quot;:&quot;ToastContainer&quot;,&quot;value&quot;:true}" await-children><!--[--><div class="toast-container svelte-1mamzwf"><!--[--><!--]--></div><!--]--><!--astro:end--></astro-island>  <script>
			window.showToast = function(message, variant, icon, duration) {
				window.dispatchEvent(new CustomEvent("mapverse:toast", {
					detail: { message: message, variant: variant || "secondary", icon: icon || "", duration: duration || 4000 }
				}));
			};
		</script> <script>
			(function() {
				function revealImage(img) {
					img.classList.add("loaded");
					var wrap = img.closest(".map-thumb-wrap, .sidebar-thumb-wrap");
					if (wrap) wrap.classList.add("loaded");
				}

				function initImageSkeletons() {
					var images = document.querySelectorAll(".map-thumb, .sidebar-map-thumb");
					for (var i = 0; i < images.length; i++) {
						var img = images[i];
						if (img.complete && img.naturalHeight > 0) {
							revealImage(img);
						} else {
							img.addEventListener("load", function() { revealImage(this); });
							img.addEventListener("error", function() { revealImage(this); });
						}
					}
				}

				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", initImageSkeletons);
				} else {
					initImageSkeletons();
				}

				var observer = new MutationObserver(function(mutations) {
					for (var i = 0; i < mutations.length; i++) {
						var added = mutations[i].addedNodes;
						for (var j = 0; j < added.length; j++) {
							var node = added[j];
							if (node.nodeType !== 1) continue;
							var imgs = node.querySelectorAll ? node.querySelectorAll(".map-thumb, .sidebar-map-thumb") : [];
							for (var k = 0; k < imgs.length; k++) {
								var img = imgs[k];
								if (img.complete && img.naturalHeight > 0) {
									revealImage(img);
								} else {
									img.addEventListener("load", function() { revealImage(this); });
									img.addEventListener("error", function() { revealImage(this); });
								}
							}
						}
					}
				});
				observer.observe(document.body, { childList: true, subtree: true });

				var bar = document.getElementById("page-progress-bar");
				if (bar) {
					var hasNavigation = (window.performance && performance.getEntriesByType && performance.getEntriesByType("navigation").length > 0 && performance.getEntriesByType("navigation")[0].type !== "reload" && performance.getEntriesByType("navigation")[0].type !== "back_forward" && document.referrer && document.referrer.includes(window.location.host));

					if (hasNavigation || sessionStorage.getItem("mv_navigating") === "1") {
						sessionStorage.removeItem("mv_navigating");
						bar.style.transition = "none";
						bar.style.width = "70%";
						bar.style.opacity = "1";
						void bar.offsetWidth;
						bar.style.transition = "width 0.2s ease, opacity 0.3s ease 0.2s";
						bar.style.width = "100%";
						bar.style.opacity = "0";
					}

					document.addEventListener("click", function(e) {
						var link = e.target.closest("a[href]");
						if (!link) return;
						var href = link.getAttribute("href");
						if (!href || href.startsWith("#") || href.startsWith("javascript") || link.target === "_blank") return;
						if (href.startsWith("http") && !href.includes(window.location.host)) return;
						sessionStorage.setItem("mv_navigating", "1");
					});
				}
			})();
		</script> <script>
				(function() {
					function isEditableTarget(target) {
						if (!(target instanceof HTMLElement)) return false;
						return target.matches("input, textarea, select, [contenteditable='true']");
					}

					function focusGlobalSearch() {
						var search = document.getElementById("global-search");
						if (!(search instanceof HTMLInputElement)) return;
						search.scrollIntoView({ block: "center", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth" });
						search.focus();
						search.select();
					}

					document.addEventListener("keydown", function(event) {
						if (event.defaultPrevented) return;
						if (!(event.ctrlKey || event.metaKey) || event.key.toLowerCase() !== "k") return;
						if (event.altKey || event.shiftKey) return;
						if (isEditableTarget(event.target)) return;
						if (document.querySelector("dialog[open]")) return;

						event.preventDefault();
						focusGlobalSearch();
					});
				})();
			</script> </body> </html>