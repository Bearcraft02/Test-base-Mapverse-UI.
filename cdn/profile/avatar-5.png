count</span> </div> <span class="profile-dropdown-label" data-astro-cid-3ef6ksr2>Your MapVerse</span> <a href="/dashboard" data-astro-cid-3ef6ksr2>Dashboard</a> <a href="/dashboard#my-library" data-astro-cid-3ef6ksr2>My library</a> <a href="/dashboard/maps" data-astro-cid-3ef6ksr2>My maps</a> <a href="/tokens" data-astro-cid-3ef6ksr2>Token wallet</a> <a href="/dashboard/settings" data-astro-cid-3ef6ksr2>Settings</a> <span class="profile-dropdown-label" data-astro-cid-3ef6ksr2>Community</span> <a href="https://discord.gg/xFgTJtebgp" target="_blank" data-astro-cid-3ef6ksr2>Discord</a> <a href="https://blog.mapverse.net" target="_blank" data-astro-cid-3ef6ksr2>Blog</a> <a href="/logout" class="profile-logout" data-astro-cid-3ef6ksr2>Logout</a>  </div> </div> </div> </div> <div class="global-search-row" data-astro-cid-3ef6ksr2><form class="header-search" role="search" action="/search" method="get" data-astro-cid-6gzi6o6l>  <div class="search-field" data-astro-cid-6gzi6o6l> <i class="bi bi-search" aria-hidden="true" data-astro-cid-6gzi6o6l></i> <input id="global-search" name="q" type="search" value placeholder="Search maps or players…" aria-label="Search maps or players" aria-controls="global-search-suggestions" aria-expanded="false" autocomplete="off" maxlength="200" required data-astro-cid-6gzi6o6l> <button type="submit" data-astro-cid-6gzi6o6l>Search <span aria-hidden="true" data-astro-cid-6gzi6o6l>→</span></button> </div> <div id="global-search-suggestions" class="search-suggestions" aria-label="Search suggestions" hidden data-astro-cid-6gzi6o6l></div> <span class="search-status" role="status" aria-live="polite" data-astro-cid-6gzi6o6l></span> </form> <script type="module">function R(l){const e=l.querySelector('input[name="q"]'),s=l.querySelector(".search-suggestions"),g=l.querySelector(".search-status");let b,E,y=0,x="",A="",w=!1,v=!1;const $=()=>[...s.querySelectorAll("a")];function p(){clearTimeout(b),E?.abort(),y++,s.hidden=!0,e.setAttribute("aria-expanded","fals